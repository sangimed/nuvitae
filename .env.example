POSTGRES_USER=nuvitae
POSTGRES_PASSWORD=nuvitae_dev_password
POSTGRES_DB=nuvitae
QUEUE_PASSWORD=nuvitae_queue_password
# Generate distinct high-entropy values (for example, `openssl rand -base64 48`)
# before Community deployment. Do not use these names as literal secrets.
NUVITAE_COMMUNITY_ACCESS_SECRET=<generate-a-unique-48-byte-secret>
NUVITAE_PRIVATE_STORAGE_SIGNING_SECRET=<generate-a-unique-48-byte-secret>
NUVITAE_PROVIDER_SESSION_ENCRYPTION_SECRET=<generate-a-unique-48-byte-secret>
# true when the public application is served over HTTPS (required for production).
NUVITAE_COMMUNITY_COOKIE_SECURE=true
NUVITAE_COMMUNITY_SESSION_TTL_SECONDS=86400
LOCAL_UID=1000
LOCAL_GID=1000
