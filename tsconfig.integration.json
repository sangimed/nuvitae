{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@nuvitae/contracts": ["packages/contracts/src/index.ts"],
      "@nuvitae/domain": ["packages/domain/src/index.ts"],
      "@nuvitae/extraction": ["packages/extraction/src/index.ts"],
      "@nuvitae/persistence": ["packages/persistence/src/index.ts"],
      "@nuvitae/storage": ["packages/storage/src/index.ts"],
      "@nuvitae/test-fixtures": ["packages/test-fixtures/src/index.ts"]
    }
  },
  "include": [
    "tests/contract/**/*.ts",
    "tests/integration/import-resume/**/*.ts",
    "tests/integration/persistence/**/*.ts"
  ]
}
