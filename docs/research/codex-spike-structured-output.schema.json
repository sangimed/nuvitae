{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuvitae.local/spikes/codex-resume-extraction.schema.json",
  "title": "Temporary Codex Resume Extraction Spike Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "personalInformation",
    "workExperience",
    "education",
    "skills",
    "languages",
    "evidence",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": "codex-spike-2026-07-30" },
    "fixtureId": { "type": "string", "minLength": 1 },
    "personalInformation": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldCandidate" }
    },
    "workExperience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "employer", "roles", "evidenceIds", "classification", "confidence"],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "employer": { "$ref": "#/$defs/fieldCandidate" },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "startDate", "endDate", "responsibilities", "evidenceIds", "classification", "confidence"],
              "properties": {
                "title": { "$ref": "#/$defs/fieldCandidate" },
                "startDate": { "$ref": "#/$defs/nullableFieldCandidate" },
                "endDate": { "$ref": "#/$defs/nullableFieldCandidate" },
                "responsibilities": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/fieldCandidate" }
                },
                "evidenceIds": { "$ref": "#/$defs/evidenceIdList" },
                "classification": { "$ref": "#/$defs/classification" },
                "confidence": { "$ref": "#/$defs/confidence" }
              }
            }
          },
          "evidenceIds": { "$ref": "#/$defs/evidenceIdList" },
          "classification": { "$ref": "#/$defs/classification" },
          "confidence": { "$ref": "#/$defs/confidence" }
        }
      }
    },
    "education": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldCandidate" }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldCandidate" }
    },
    "languages": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldCandidate" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRecord" }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnings", "unresolvedQuestions"],
      "properties": {
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "unresolvedQuestions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "fieldCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "fieldPath", "value", "evidenceIds", "classification", "confidence"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "fieldPath": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIdList" },
        "classification": { "$ref": "#/$defs/classification" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "nullableFieldCandidate": {
      "anyOf": [
        { "$ref": "#/$defs/fieldCandidate" },
        { "type": "null" }
      ]
    },
    "evidenceIdList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceFragmentId", "documentLocation", "classification", "confidence"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "sourceFragmentId": { "type": "string", "minLength": 1 },
        "documentLocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "locator"],
          "properties": {
            "format": { "enum": ["pdf", "docx"] },
            "locator": { "type": "string", "minLength": 1 }
          }
        },
        "classification": { "$ref": "#/$defs/classification" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "classification": { "enum": ["explicit", "inferred"] },
    "confidence": { "enum": ["high", "medium", "low", "not_applicable"] }
  }
}
