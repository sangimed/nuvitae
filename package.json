{
  "name": "nuvitae",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "format": "prettier --write \"*.{json,mjs,ts,yml,yaml}\" \"apps/**/*.{json,ts,tsx,css}\" \"packages/**/*.{json,ts}\" \"tests/**/*.ts\" \"README.md\"",
    "format:check": "prettier --check \"*.{json,mjs,ts,yml,yaml}\" \"apps/**/*.{json,ts,tsx,css}\" \"packages/**/*.{json,ts}\" \"tests/**/*.ts\" \"README.md\"",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.integration.json",
    "test": "vitest run",
    "test:integration:persistence": "vitest run --config vitest.persistence.config.ts",
    "build": "pnpm -r build",
    "dev": "turbo dev --parallel",
    "db:migration:generate": "pnpm --filter @nuvitae/persistence db:migration:generate",
    "db:migration:create": "pnpm --filter @nuvitae/persistence db:migration:create",
    "db:migration:run": "pnpm --filter @nuvitae/persistence db:migration:run",
    "db:migration:revert": "pnpm --filter @nuvitae/persistence db:migration:revert",
    "db:migration:show": "pnpm --filter @nuvitae/persistence db:migration:show"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/testing": "11.1.28",
    "@next/eslint-plugin-next": "15.5.22",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.0.1",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "reflect-metadata": "0.2.2",
    "turbo": "2.10.7",
    "typeorm": "0.3.28",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
