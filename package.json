{
  "name": "nuvitae",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "design:lint": "design.md lint .stitch/DESIGN.md",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.integration.json",
    "test": "vitest run",
    "test:integration:persistence": "vitest run --config vitest.persistence.config.ts",
    "build": "pnpm -r build",
    "dev": "turbo dev --parallel",
    "fixtures:resume-import": "pnpm --filter @nuvitae/test-fixtures generate:resume-import --",
    "db:migration:generate": "pnpm --filter @nuvitae/persistence db:migration:generate",
    "db:migration:create": "pnpm --filter @nuvitae/persistence db:migration:create",
    "db:migration:run": "pnpm --filter @nuvitae/persistence db:migration:run",
    "db:migration:revert": "pnpm --filter @nuvitae/persistence db:migration:revert",
    "db:migration:show": "pnpm --filter @nuvitae/persistence db:migration:show"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@google/design.md": "0.4.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/testing": "11.2.3",
    "@next/eslint-plugin-next": "16.3.4",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "reflect-metadata": "0.2.2",
    "turbo": "2.10.12",
    "typeorm": "0.3.28",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
