{
  "name": "@nuvitae/persistence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./ports": {
      "types": "./src/ports.ts",
      "default": "./dist/ports.js"
    },
    "./typeorm": {
      "types": "./src/typeorm.ts",
      "default": "./dist/typeorm.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migration:generate": "pnpm build && typeorm -d dist/cli-data-source.js migration:generate ../../.tmp/migrations/Generated",
    "db:migration:create": "typeorm migration:create ../../.tmp/migrations/Empty",
    "db:migration:run": "pnpm build && typeorm -d dist/cli-data-source.js migration:run",
    "db:migration:revert": "pnpm build && typeorm -d dist/cli-data-source.js migration:revert",
    "db:migration:show": "pnpm build && typeorm -d dist/cli-data-source.js migration:show"
  },
  "dependencies": {
    "@nuvitae/contracts": "workspace:*",
    "@nuvitae/domain": "workspace:*",
    "@nuvitae/import-application": "workspace:*",
    "@nestjs/typeorm": "12.0.2",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.2"
  }
}
