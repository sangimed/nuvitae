{
  "name": "@nuvitae/import-application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./codex": {
      "types": "./src/providers/codex.ts",
      "default": "./dist/providers/codex.js"
    },
    "./testing": {
      "types": "./src/providers/testing/index.ts",
      "default": "./dist/providers/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nuvitae/contracts": "workspace:*",
    "@nuvitae/domain": "workspace:*",
    "@nuvitae/extraction": "workspace:*"
  }
}
